{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on"
        }
      }
    }
  },
  "files": {
    "includes": [
      "cli/**/*.ts",
      "guardian/**/*.ts",
      "cli/**/*.json",
      "guardian/**/*.json",
      "package.json",
      "biome.json",
      "!!**/node_modules",
      "!!**/.build"
    ]
  }
}

#!/bin/bash
set -euo pipefail

echo "=== L1: Swift Unit Tests ==="
swift test 2>&1

echo "=== L1: TS Unit Tests ==="
cd cli && bun test 2>&1 && cd ..

echo "=== L1: Guardian Unit Tests ==="
cd guardian && bun test 2>&1 && cd ..

echo "=== G1: Swift Lint ==="
swiftlint lint --strict --quiet

echo "=== G1: TS Lint ==="
cd cli && bunx biome check --error-on-warnings . && cd ..
cd guardian && bunx biome check --error-on-warnings . && cd ..

echo "=== IPC L2: Integration Tests ==="
if [ ! -f scripts/integration-test.sh ]; then
  echo "❌ scripts/integration-test.sh missing" >&2
  exit 1
fi
bash scripts/integration-test.sh

echo "✓ pre-push passed"
